# Copia este archivo a .env y ajusta los valores. .env nunca se versiona (RES-13).

# SQL Server 2022 (Express sirve) instalado en la máquina, con TCP/IP habilitado.
BD_SERVIDOR=localhost
BD_PUERTO=1433
BD_NOMBRE=KronoBarber
BD_USUARIO=kronobarber
BD_CONTRASENA=cambiar-en-local

# En local el certificado de SQL Server es autofirmado: sin esto el driver rechaza
# la conexión con "self signed certificate".
BD_CIFRADO=false
BD_CONFIAR_CERTIFICADO=true

PUERTO=3000
