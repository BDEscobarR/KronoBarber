{
  "name": "kronobarber",
  "version": "0.1.0",
  "description": "Plataforma web de gestión y reserva de turnos para barberías",
  "private": true,
  "main": "dist/src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/src/main.js",
    "build": "tsc",
    "test": "vitest",
    "cov": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "arquitectura": "vitest run tests/arquitectura.test.ts",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BDEscobarR/KronoBarber.git"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
