{
  "name": "kronobarber",
  "version": "0.1.0",
  "description": "Plataforma web de gestión y reserva de turnos para barberías",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch backend/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "probar": "node --import tsx --test \"backend/tests/**/*.test.ts\"",
    "verificar": "npm run typecheck && npm run lint && npm run probar",
    "verificar:dip": "grep -rn \"from ['\\\"].*infraestructura\" backend/src/dominio/ && echo '❌ DIP roto' || echo '✅ dominio limpio'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BDEscobarR/KronoBarber.git"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
